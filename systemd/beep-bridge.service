[Unit]
Description=BEEP bridge HTTP API for DogZilla S2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/beep_bridge
Environment=ROS_DOMAIN_ID=16
Environment=ROS_LOCALHOST_ONLY=0
Environment=BEEP_APP_HOST=192.168.8.88
Environment=BEEP_CAMERA_URL=http://192.168.8.88:6500/video_feed
Environment=BEEP_FORWARD_UNTIL_MAX_S=12
Environment=BEEP_MOTOR_BACKEND=sdk
Environment=BEEP_TURN_SEGMENT_S=0.90
Environment=BEEP_SDK_STEP=10
Environment=BEEP_SDK_GAIT=firmware
Environment=BEEP_SDK_PACE=normal
Environment=BEEP_SDK_BODY_HEIGHT=108
Environment=BEEP_SDK_SHOULDER_YAW=0
Environment=BEEP_SDK_IMU=0
Environment=BEEP_MAP_DIR=/home/pi/beep_bridge/maps
Environment=BEEP_SDK_FORWARD_M_PER_S=0.045
Environment=BEEP_SDK_STRAFE_M_PER_S=0.035
Environment=BEEP_SDK_TURN_RAD_PER_S=0.45
ExecStart=/bin/bash -lc 'source /opt/ros/foxy/setup.bash; source /home/pi/cartographer_ws2/install/setup.bash 2>/dev/null || true; mkdir -p /home/pi/beep_bridge/logs /home/pi/beep_bridge/maps; exec python3 /home/pi/beep_bridge/beep_bridge.py'
Restart=always
RestartSec=3
TimeoutStopSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
